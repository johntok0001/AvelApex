#!/bin/bash
# Remove an older Avel Apex of the same kind so the new one replaces it cleanly.
# $1 is the path of the component package being installed.
if [ "$(basename "$1")" = "AvelApex-VST3.pkg" ]; then
    rm -rf "/Library/Audio/Plug-Ins/VST3/Avel Apex.vst3"
elif [ "$(basename "$1")" = "AvelApex-AU.pkg" ]; then
    rm -rf "/Library/Audio/Plug-Ins/Components/Avel Apex.component"
fi
exit 0
